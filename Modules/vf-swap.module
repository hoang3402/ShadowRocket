#!name=Trạm đổi pin VinFast
#!desc=Thông báo khi số pin tại các trạm đổi pin gần bạn thay đổi. Mở bản đồ trạm trong app một lần để lấy token.

[Script]
vf-swap-capture = type=http-response,pattern=^https:\/\/escooter-api\.vinfast\.vn\/api-gateway\/operation-support\/v1\.0\/battery-swap-stations\/near,requires-body=true,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/hoang3402/ShadowRocket/main/Js/vf-swap.js
# Mặc định theo dõi 5 trạm gần nhất. Chỉ theo dõi trạm muốn: thêm vào cuối dòng dưới ,argument="names=12 lê lợi|45 nguyễn huệ"
vf-swap-poll = type=cron,cronexpr="*/5 * * * *",timeout=30,script-path=https://raw.githubusercontent.com/hoang3402/ShadowRocket/main/Js/vf-swap.js

[MITM]
hostname = %APPEND% escooter-api.vinfast.vn
